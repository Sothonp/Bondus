# Copy to .env and fill in what you need. Every value is optional.
# The FastAPI backend (src/config.py) reads .env; the Vercel function in api/
# reads GEMINI_API_KEY from .env.local / the Vercel project settings.

# --- Answer generation -------------------------------------------------------
# auto = first key found: Anthropic, then Gemini, then Groq, then SEA-LION;
# "none" returns the retrieved passages without an LLM.
LLM_PROVIDER=auto
# If the chosen provider fails (overloaded, rate limited, bad key), try the other
# configured providers, then answer with the retrieved passages.
LLM_FALLBACK=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=high
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest
# Groq keys start with gsk_ (https://console.groq.com/keys); anything else is ignored.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=3000
# If less than this fits after trimming history and passages, the next model answers.
GROQ_MIN_COMPLETION_TOKENS=1500
# Groq rejects requests whose prompt + max tokens exceed this (free tier: 8000).
GROQ_TOKENS_PER_MINUTE=8000
# Wait for a Groq rate limit only when it clears within this many seconds; otherwise fall back.
GROQ_MAX_RETRY_WAIT=12
LLM_MAX_TOKENS=16000

# --- Embeddings --------------------------------------------------------------
# "hashing" needs no model download (useful offline / in CI).
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
PRELOAD_EMBEDDER=true

# --- Storage -----------------------------------------------------------------
VECTOR_STORE_PATH=./storage/vector_index
DATA_DIR=./data
FRONTEND_DIST_DIR=./dist

# --- Ingestion ---------------------------------------------------------------
# Changing these requires re-indexing: uv run python scripts/ingest_corpus.py
CHUNK_SIZE=500
CHUNK_OVERLAP=50
KHMER_SEGMENTER=auto
MAX_UPLOAD_MB=25

# OCR for scanned PDFs and images: auto | always | never,
# engine auto | gemini | groq | kiri | hybrid.
#   gemini/groq  one vision model reads the whole page: formulas in LaTeX and
#                page structure, but Khmer words come back garbled now and then.
#   kiri          the local model, on the CPU or (KIRI_DEVICE=cuda) the GPU.
#                 Accurate Khmer, no API cost, but it transcribes no formulas.
#   hybrid        both: Kiri reads the Khmer of the page and its reading is
#                 given to the vision model, which transcribes the page with
#                 the maths and spells the Khmer the way Kiri read it. This is
#                 the one to use for the Khmer maths corpus.
OCR_MODE=auto
OCR_ENGINE=auto

# OCR_ENGINE=hybrid only. Vision engines are tried in order; one with no key is
# skipped. Groq page OCR needs a paid tier (see GROQ_PAGE_MAX_TOKENS).
HYBRID_VISION_ENGINES=gemini,groq
# false: a page whose vision engines all failed is still indexed from Kiri's
# Khmer-only reading (prose, no formulas). true: fail the page instead, so a
# re-run transcribes it properly rather than leaving it in the index without
# its mathematics.
HYBRID_REQUIRE_VISION=false

# --- Photos attached to questions ---------------------------------------------
# Every engine listed reads each photo in parallel: kiri (local, free) for Khmer
# words, then the first vision model that works (groq, then gemini) for math.
IMAGE_OCR_ENGINES=kiri,groq,gemini
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Groq's free tier allows 1000 output tokens per minute for Qwen.
GROQ_VISION_MAX_TOKENS=1000
# Corpus pages (OCR_ENGINE=groq or hybrid) need far more room than one photo.
# The free tier rejects a request this large outright, and the hybrid engine
# then moves on to the next vision engine.
GROQ_PAGE_MAX_TOKENS=4000
GROQ_VISION_FREQUENCY_PENALTY=0.4
GEMINI_VISION_MODEL=gemini-3.5-flash
IMAGE_MAX_COUNT=4
IMAGE_MAX_MB=10
PRELOAD_KIRI=true

# --- SEA-LION (AI Singapore) --------------------------------------------------
# An open model family trained for Southeast Asian languages, Khmer included,
# reached through an OpenAI-compatible API. Worth trying as the answering model:
# the other providers are far stronger in English than in Khmer.
# SEA_LION_API_KEY=
# Required when the key is set - there is no default, because the catalogue
# changes. Take an id from the SEA-LION model list.
# SEA_LION_MODEL=
# SEA_LION_BASE_URL=https://api.sea-lion.ai/v1
# SEA_LION_TEMPERATURE=0.2

# --- Retrieval ---------------------------------------------------------------
TOP_K=5
# Cosine cutoff for sentence-transformers embeddings. Lexical hashing scores are much lower, so
# with EMBEDDING_BACKEND=hashing leave this unset and HASHING_SCORE_THRESHOLD applies instead;
# setting SCORE_THRESHOLD here overrides it for both backends.
SCORE_THRESHOLD=0.75
HASHING_SCORE_THRESHOLD=0.15
MAX_CONTEXT_CHARS=12000

# --- Server ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://localhost:8000
LOG_LEVEL=INFO

# --- Frontend (Vite) ---------------------------------------------------------
# Leave empty to use the dev proxy (vite.config.js) or same-origin serving.
# Set it when the built app is hosted separately from the API.
VITE_RAG_API_URL=
# Where the dev proxy forwards /api/query, /api/ingest and /health.
RAG_API_PROXY_TARGET=http://127.0.0.1:8000
