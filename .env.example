# Copy to .env and fill in what you need. Every value is optional.
# The FastAPI backend (src/config.py) reads .env; the Vercel function in api/
# reads GEMINI_API_KEY from .env.local / the Vercel project settings.

# --- Answer generation -------------------------------------------------------
# auto = first key found: Anthropic, Gemini, Groq, Cerebras, OpenRouter, SEA-LION;
# "none" returns the retrieved passages without an LLM. Whichever answers first,
# LLM_FALLBACK below puts every other configured provider behind it as backup.
LLM_PROVIDER=auto
# If the chosen provider fails (overloaded, rate limited, bad key), try the other
# configured providers, then answer with the retrieved passages.
LLM_FALLBACK=true
# How each question picks among those models. Either way, one that fails is
# rested and skipped for a while instead of being retried on every question.
#   priority = start at the head of the chain whenever it is healthy. Groq answers
#              in about 1.5 s against 10-30 s for the Gemini models, so it carries
#              what it can and the rest catch the overflow.
#   rotate   = start one place further down the chain each time, so several free
#              tiers share the load and none reaches its per-minute quota alone.
#              Slower per answer; worth it once the head is rate limited most of
#              the time (check llm_resting in /health to tell).
LLM_SELECTION=priority
# A model that rate limited or fell over is skipped for this long (doubling while
# it keeps failing, up to the maximum) instead of being retried on every question.
# A provider that sends `retry-after` -- Groq does -- sets its own wait instead.
LLM_COOLDOWN_SECONDS=15
LLM_MAX_COOLDOWN_SECONDS=300
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=high
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Gemini also thinks before answering, at the same cost to the first token.
# minimal/low for chat; raise it only if answer quality drops.
GEMINI_THINKING_LEVEL=low
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest
# Groq keys start with gsk_ (https://console.groq.com/keys); anything else is ignored.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# gpt-oss reasons before it answers, and those tokens come before the first
# visible one -- so they are the whole wait the student sees, spent on thinking
# that is discarded. low/medium/high; blank sends nothing, for a model that
# rejects the parameter.
GROQ_REASONING_EFFORT=low
GROQ_MAX_TOKENS=3000
# If less than this fits after trimming history and passages, the next model answers.
GROQ_MIN_COMPLETION_TOKENS=1500
# Groq rejects requests whose prompt + max tokens exceed this (free tier: 8000).
GROQ_TOKENS_PER_MINUTE=8000
# Wait for a Groq rate limit only when it clears within this many seconds; otherwise fall back.
GROQ_MAX_RETRY_WAIT=12
LLM_MAX_TOKENS=16000

# --- Backstops: tried after Groq and Gemini, never ahead of them ---------------
# Cerebras serves the same open models as Groq on its own hardware, so it is a
# second quota for an answer of the same character -- its gpt-oss-120b is the
# model Groq serves. Keys start with csk-; 1M free tokens a day, and the free
# tier caps context at 8192 tokens (hence CEREBRAS_TOKENS_PER_MINUTE below).
# A key with no billing set up answers 402, which rests it for the longest
# cooldown rather than costing a round-trip every fifteen seconds.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_FALLBACK_MODELS=
CEREBRAS_TOKENS_PER_MINUTE=8000
# OpenRouter fronts many providers behind one key, so it reaches a different set
# of hosts when Groq, Gemini and Cerebras have all run dry. Keys start with sk-or-.
# Models ending in :free cost nothing but are rate limited per minute and per day.
# `curl https://openrouter.ai/api/v1/models` lists the catalogue (no key needed);
# the free ones are those whose id ends in :free.
OPENROUTER_API_KEY=
# These three were measured on two Khmer calculus questions: each answered
# correctly, in Khmer, with $$ formulas, both times. Both google/gemma-4-*:free
# endpoints are rate limited upstream (a pool shared by all OpenRouter users, not
# your key), so they are not usable however good they look. Retest before
# changing these -- dots-3-note-preview looked fine on one question and lost both
# its LaTeX and its answer on the next.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free
# Nearly every free model here can think before answering, spending the completion
# budget on reasoning the student never sees. Leave true unless a model you pick
# demonstrably answers better with it.
OPENROUTER_DISABLE_REASONING=true
# Optional: attributes this app's traffic on openrouter.ai.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Bondus

# SEA-LION (AI Singapore) is trained for Southeast Asian languages, so it is the
# one backstop that is *better* at Khmer than the models ahead of it, not worse.
# `curl -H "Authorization: Bearer $KEY" https://api.sea-lion.ai/v1/models` lists
# what your key can reach. Avoid Qwen-SEA-LION-v4.5: it reasons before answering
# and returns an empty answer when the budget runs out mid-reasoning.
SEA_LION_API_KEY=
SEA_LION_MODEL=aisingapore/Gemma-SEA-LION-v4-27B-IT

# --- Embeddings --------------------------------------------------------------
# "hashing" needs no model download (useful offline / in CI).
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
PRELOAD_EMBEDDER=true

# --- Storage -----------------------------------------------------------------
VECTOR_STORE_PATH=./storage/vector_index
DATA_DIR=./data
FRONTEND_DIST_DIR=./dist

# --- Ingestion ---------------------------------------------------------------
# Changing these requires re-indexing: uv run python scripts/ingest_corpus.py
CHUNK_SIZE=500
CHUNK_OVERLAP=50
KHMER_SEGMENTER=auto
MAX_UPLOAD_MB=25

# OCR for scanned PDFs and images: auto | always | never,
# engine auto | gemini | groq | kiri | surya | hybrid.
#   gemini/groq  one vision model reads the whole page: formulas in LaTeX and
#                page structure, but Khmer words come back garbled now and then.
#   kiri          the local model, on the CPU or (KIRI_DEVICE=cuda) the GPU.
#                 Accurate Khmer, no API cost, but it transcribes no formulas.
#   surya         Surya 2, local and free: whole pages with clean LaTeX and
#                 headings (so formula sheets chunk on their topics), but its
#                 Khmer is weaker than Kiri's -- a word swapped for a look-alike
#                 on clean scans, garbled on low-resolution photos.
#   hybrid        both: Kiri reads the Khmer of the page and its reading is
#                 given to the vision model, which transcribes the page with
#                 the maths and spells the Khmer the way Kiri read it. This is
#                 the one to use for the Khmer maths corpus.
OCR_MODE=auto
OCR_ENGINE=auto

# OCR_ENGINE=hybrid only. Vision engines are gemini, groq, openrouter and surya;
# one with no key (surya: no SURYA_PYTHON) is skipped. surya=local, so
# HYBRID_VISION_ENGINES=gemini,surya falls back to it when Gemini's quota runs out. groq is left out: its only vision model is Qwen, and
# the project uses no Chinese models.
HYBRID_VISION_ENGINES=gemini,openrouter
# first: engines are tried in order, one call per page.
# ensemble: all engines read the page at once and the reading that agrees best
# with Kiri's Khmer and with the other engines' formulas is kept (one call per
# engine per page).
HYBRID_COMBINE=first
OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free
# false: a page whose vision engines all failed is still indexed from Kiri's
# Khmer-only reading (prose, no formulas). true: fail the page instead, so a
# re-run transcribes it properly rather than leaving it in the index without
# its mathematics.
HYBRID_REQUIRE_VISION=false

# Surya 2 (OCR_ENGINE=surya, or surya in HYBRID_VISION_ENGINES). surya-ocr cannot
# share this project's environment, so give it its own and point SURYA_PYTHON
# at that interpreter:
#   uv venv ~/.venvs/surya && VIRTUAL_ENV=~/.venvs/surya uv pip install surya-ocr
# It serves its model with llama.cpp: download a llama-server build from
# https://github.com/ggml-org/llama.cpp/releases (the ubuntu-cuda one for a GPU).
# SURYA_BACKEND=vllm uses vLLM in Docker instead.
# SURYA_PYTHON=/home/you/.venvs/surya/bin/python
# SURYA_BACKEND=llamacpp
# SURYA_LLAMA_BINARY=/opt/llama.cpp/llama-server
# SURYA_TIMEOUT_SECONDS=600

# --- Photos attached to questions ---------------------------------------------
# Every engine listed reads each photo in parallel: kiri (local, free) for Khmer
# words, then the first vision model that works for math. No Chinese models:
# Groq's only vision model is Qwen, so groq is not listed.
IMAGE_OCR_ENGINES=kiri,gemini
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Groq's free tier allows 1000 output tokens per minute for Qwen.
GROQ_VISION_MAX_TOKENS=1000
# Corpus pages (OCR_ENGINE=groq or hybrid) need far more room than one photo.
# The free tier rejects a request this large outright, and the hybrid engine
# then moves on to the next vision engine.
GROQ_PAGE_MAX_TOKENS=4000
GROQ_VISION_FREQUENCY_PENALTY=0.4
GEMINI_VISION_MODEL=gemini-3.5-flash
IMAGE_MAX_COUNT=4
IMAGE_MAX_MB=10
PRELOAD_KIRI=true

# Endpoints for the backstops above; the defaults are the public APIs.
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# SEA_LION_BASE_URL=https://api.sea-lion.ai/v1
# SEA_LION_TEMPERATURE=0.2

# --- Retrieval ---------------------------------------------------------------
TOP_K=5
# Cosine cutoff for sentence-transformers embeddings. Lexical hashing scores are much lower, so
# with EMBEDDING_BACKEND=hashing leave this unset and HASHING_SCORE_THRESHOLD applies instead;
# setting SCORE_THRESHOLD here overrides it for both backends.
SCORE_THRESHOLD=0.75
HASHING_SCORE_THRESHOLD=0.15
MAX_CONTEXT_CHARS=12000

# --- Server ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://localhost:8000
LOG_LEVEL=INFO

# --- Frontend (Vite) ---------------------------------------------------------
# Leave empty to use the dev proxy (vite.config.js) or same-origin serving.
# Set it when the built app is hosted separately from the API.
VITE_RAG_API_URL=
# Where the dev proxy forwards /api/query, /api/ingest and /health.
RAG_API_PROXY_TARGET=http://127.0.0.1:8000
